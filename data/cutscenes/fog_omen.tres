[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://data/resources/cutscene.gd" id="1_cut"]

[resource]
script = ExtResource("1_cut")
id = "fog_omen"
min_day = 1
priority = 30
requires_flag = "fog_omen_day"
script_text = "# Điềm báo: sau đêm có cá thu phát sáng (hoặc ngày 7), quầng sáng lạ trong sương đông bắc.
tint dawn
camera dock_view 0 2.5
fade_in 1.0
spawn Crate crate crate_spot
spawn Rin rin rin_start
move_to Rin rin_stop 1.0
pause 0.4
emote Rin ! 1.0
face Rin right
spawn Glow glow fog_glow
narrate \"Ngoài khơi phía đông bắc, giữa màn sương, có một quầng sáng xanh nhấp nháy.\"
camera fog_view 2.0 1.2
pause 1.0
narrate \"Không phải đèn ghe. Không phải hải đăng. Nó sáng theo nhịp, như đang thở.\"
camera dock_view 1.5 2.5
speak Rin \"Cái gì vậy trời...\"
narrate \"Điện thoại rung. App Rin's Catch tự bật lên.\"
narrate \"[ERR] tọa độ 0x7F3A: vùng biển không có trong bản đồ.\"
speak Rin \"Vùng không có trong bản đồ? Code tao viết đâu có dòng này...\"
speak Rin \"Mai phải ra đó coi thử.\"
fade_out 1.2"
