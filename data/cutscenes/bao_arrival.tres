[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://data/resources/cutscene.gd" id="1_cut"]

[resource]
script = ExtResource("1_cut")
id = "bao_arrival"
script_text = "# Hết ca ngày 1: Rin vừa nấu vừa bưng một mình. Bảo đẩy cửa bước vào.
camera room_view 0 1
spawn Rin rin rin_spot 1.6
face Rin right
narrate \"Quán vừa vãn khách. Cửa kêu kẽo kẹt.\"
spawn Bao bao door 1.6
face Bao left
move_to Bao bao_stop 2.0
emote Rin ! 1.0
speak Bảo \"Ê Rin! Tưởng mày bỏ nghề code luôn rồi chứ.\"
speak Rin \"...Bảo? Sao mày tìm được tới đây?\"
speak Bảo \"Startup sập rồi thì tao cũng thất nghiệp. Nghe nói mày mở quán ở quê ông nội.\"
emote Bao ... 1.0
speak Bảo \"Hồi chiều tao đứng ngoài coi. Mày vừa nấu vừa bưng, chạy muốn hụt hơi.\"
speak Bảo \"Cho tao làm phục vụ đi. Bưng bê dọn dẹp tao lo, mày lo nấu.\"
speak Rin \"...Lương thấp lắm đó.\"
emote Bao note 1.0
speak Bảo \"Có cơm ăn là được. Mà cái app Rin's Catch, mày vẫn xài hả? Tao tưởng xoá rồi.\"
speak Rin \"Còn xài. Mai bắt đầu làm nha.\"
set_flag bao_joined
pause 0.4"
