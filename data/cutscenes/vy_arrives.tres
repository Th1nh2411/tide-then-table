[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://data/resources/cutscene.gd" id="1_cut"]

[resource]
script = ExtResource("1_cut")
id = "vy_arrives"
min_day = 4
priority = 25
script_text = "# Ngày 4: Vy, tiểu thư xóm trên, xài hết tiền đi chơi nên xin làm thêm buổi tối.
camera kitchen_view 0 1.6
fade_in 0.6
spawn Bao bao bao_stove 1.4
spawn Rin rin rin_spot 1.4
spawn Vy vy vy_start 1.4
move_to Vy vy_stop 2.4
face Rin left
speak \"Vy (che)\" \"Trời ơi mùi cá... Ủa, ai là chủ quán ở đây?\"
speak Rin \"Anh. Chắc vậy.\"
speak \"Vy (kieu)\" \"Em là Vy, nhà ở xóm trên. Lương một ca bao nhiêu vậy anh?\"
emote Rin ? 1.0
speak Vy \"Em cần tiền đi chơi với tụi bạn. Ba mẹ cắt tiền tiêu vặt, kêu tự kiếm đi rồi biết.\"
speak Vy \"Hai trăm một ca. Em chỉ bưng với dọn thôi nha, không đụng cá sống đâu.\"
speak Bảo \"Tiểu thư hả trời. Mày chạy muốn rớt dép mỗi tối, nhận đi.\"
choice \"Nhận Vy làm luôn\" hire \"Để anh tính đã\" later
label hire
speak Rin \"Ừ, sao cũng được. Tối nay làm luôn nha.\"
speak \"Vy (kieu)\" \"Dễ vậy luôn? Anh tuyển người kiểu gì vậy trời.\"
set_flag vy_hire_now
goto end
label later
speak Rin \"Để anh tính chút... mà chắc tính cũng vậy thôi.\"
speak \"Vy (kieu)\" \"Anh bấm nút Nhân viên là thấy tên em. Lâu quá em đi quán khác đó.\"
label end
speak \"Vy (che)\" \"Mà bàn này ai lau vậy? Dính dính hết trơn.\"
emote Bao ... 1.0
speak Bảo \"Thiếu người nữa thì đăng tin tuyển dụng. Tốn chút tiền mà có người xịn.\"
camera room_view 0.8 1"
