[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://data/resources/cutscene.gd" id="1_cut"]

[resource]
script = ExtResource("1_cut")
id = "intro_call"
script_text = "# New Game: phòng trọ ở thành phố. Rin thất nghiệp sau khi startup sập.
camera room_view 0 1
spawn Lying rin_bed bed_spot 3
fade_in 1.5
narrate \"Ba tháng sau khi startup của Rin và Bảo sập.\"
narrate \"Rin nằm dài trong phòng trọ, lướt tin tuyển dụng tới mỏi tay.\"
emote Lying ... 1.2
speak \"Rin (buon)\" \"Gửi hai trăm cái CV. Không ai gọi lại.\"
pause 0.4
narrate \"Bụng réo. Trên bàn chỉ còn đúng một gói mì.\"
emote Lying ! 1.0
speak Rin \"Mì gói... Hồi ở ký túc xá, Bảo nấu mì ngon bá cháy.\"
speak Rin \"Trứng lòng đào, hành phi, chút nước mắm. Cả tầng kéo qua xin ăn.\"
remove Lying
spawn Rin rin bed_side 3
face Rin right
move_to Rin window_spot 1.4
emote Rin note 1.0
narrate \"Rin bấm số. Chuông đổ ba hồi.\"
speak Bảo \"(điện thoại) Alo? Rin hả? Lâu quá trời.\"
speak Rin \"Bảo. Mày còn nấu mì được không?\"
speak Bảo \"Hỏi gì kỳ vậy. Từ hồi công ty sập, tao ở nhà nấu cho cả nhà ăn.\"
speak Rin \"Mở quán đi. Quán hải sản vỉa hè, ở Xóm Đèn, chỗ nhà cũ của ông nội tao.\"
speak Rin \"Ông còn để lại chiếc ghe. Đêm tao ra khơi câu, chiều mày đứng bếp, tao bưng bê.\"
speak \"Bảo (ngac_nhien)\" \"Mày? Bưng bê? Thằng code xuyên đêm không thèm bước ra khỏi phòng?\"
speak Rin \"Thất nghiệp rồi, gì cũng làm.\"
pause 0.4
speak Bảo \"...Được. Nhưng tao là bếp trưởng. Món nướng mày tự lo, tao không đứng khói than đâu.\"
speak \"Rin (vui)\" \"Chốt! À, cái app Rin's Catch tao vẫn giữ. Sửa lại xài quản lý kho cá.\"
speak Bảo \"Cái app đó... thôi kệ. Mai tao bắt xe về.\"
emote Rin heart 1.0
narrate \"Một tuần sau, hai đứa dọn về Xóm Đèn. Đêm đầu tiên, Rin thắp đèn ra khơi.\"
fade_out 1.5
"
