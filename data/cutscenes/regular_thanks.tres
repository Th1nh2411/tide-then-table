[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://data/resources/cutscene.gd" id="1_cut"]

[resource]
script = ExtResource("1_cut")
id = "regular_thanks"
min_day = 1
priority = 10
requires_flag = "regular_served_once"
script_text = "# Sau ca có lần đầu giao đơn đặt cá: khách quen ở lại uống trà, kể chuyện biển xưa.
camera kitchen_view 0 1.6
fade_in 0.6
spawn Bao bao bao_stove 1.4
spawn Rin rin rin_spot 1.4
spawn Guest guest guest_seat 1.4
speak \"Khách quen\" \"Con cá đó nướng vừa tới. Lâu lắm rồi mới ăn được cá ngoài khơi ngon vậy.\"
speak Rin \"Dạ, chú đặt thì con ráng câu cho bằng được.\"
speak \"Khách quen\" \"Hồi trước tui cũng đi biển. Mấy đêm sương, nghe cá Ông thở ngoài xa, ầm ầm như sóng.\"
emote Rin ? 1.0
speak \"Khách quen\" \"Người ta nói cá Ông giữ cửa biển. Biển cho thì mình lấy vừa đủ thôi, đừng tham.\"
speak Bảo \"Nghe như chuyện cổ tích.\"
speak \"Khách quen\" \"Ừ, cổ tích. Mà cổ tích ở xóm này hay có thiệt lắm à nghen.\"
emote Guest note 1.0
camera room_view 0.8 1"
