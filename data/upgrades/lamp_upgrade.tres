[gd_resource type="Resource" script_class="UpgradeData" format=3]

[ext_resource type="Script" path="res://data/resources/upgrade_data.gd" id="1_upgrade"]

[resource]
script = ExtResource("1_upgrade")
id = "lamp"
display_name = "Bình dầu đèn"
description = "Bình to hơn: đèn câu cháy lâu hơn, ở ngoài khơi được lâu hơn. Dầu tự đổ đầy mỗi đêm."
levels = Array[int]([500, 2000])
values = [100.0, 140.0, 190.0]
value_labels = Array[String](["Dầu đèn 100%", "Dầu đèn 140%", "Dầu đèn 190%"])
