[gd_resource type="Resource" script_class="LinesData" format=3]

[ext_resource type="Script" path="res://data/resources/lines_data.gd" id="1_lines"]

[resource]
script = ExtResource("1_lines")
speaker = "Cô Năm"
lines = Array[String](["Tháng cô hồn rồi đó con. Tối đừng có ai kêu tên cũng dạ nghe chưa.", "Cô bày mâm cúng trước tiệm, đừng có lấy gì trên đó nha.", "Đêm không trăng thì đừng ra khơi. Ông Tư nhà con cũng đi đêm không trăng...", "Ba người mất tích rồi đó. Cái sương ngoài kia nó ăn người hay sao á.", "Thằng Út bè tôm hùm hồi này dư tiền ghê, mua ghe mới nữa."])
