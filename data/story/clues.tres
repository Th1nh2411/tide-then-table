[gd_resource type="Resource" script_class="LinesData" format=3]

[ext_resource type="Script" path="res://data/resources/lines_data.gd" id="1_lines"]

[resource]
script = ExtResource("1_lines")
speaker = ""
lines = Array[String](["Chai thư: \"Cháu nội của ông, nếu con đọc được mấy chữ này thì nghe ông: đêm nào không trăng thì đừng có ra khơi. — Ông Tư\"", "Khúc dây neo trôi dạt. Đầu dây cắt ngọt, như bằng dao. Nút buộc kiểu dân bè.", "Trang nhật ký gác đèn: \"Đêm 14. Lại thấy đèn xanh ngoài bè. Không phải sương.\"", "Chai thư thứ hai: \"Ông thấy tận mắt nó kéo thúng người ta vô sương. Ông sợ, hổng dám nói với ai hết.\"", "Tấm ván trôi, còn chữ sơn \"BÈ TÔM HÙM\". Mép ván dính gì sẫm màu, chà không ra.", "Trang cuối nhật ký gác đèn: \"Nó biết tôi thấy rồi. Nếu tôi không về, ai đọc được thì tìm dưới bè...\""])
