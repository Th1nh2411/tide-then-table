[gd_resource type="Resource" script_class="NewsData" format=3]

[ext_resource type="Script" path="res://data/resources/news_data.gd" id="1_news"]

[resource]
script = ExtResource("1_news")
pages = Array[String](["Thêm một ngư dân mất tích trong sương, là người thứ ba. Chiếc thúng trôi dạt vào bến, không người. Bà con trong xóm cho là ma da tháng Bảy bắt người thế mạng.", "Cả ba vụ mất tích đều xảy ra vào đêm không trăng. Xã đã làm lễ cúng giải hạn ở đầu bến, mong yên sóng yên người. Giá cá tuần này giảm nhẹ.", "Dây neo thúng của người mất tích đã được vớt lên. Một ngư dân lâu năm cho biết dây bị cắt gọn, không phải đứt.", "Theo lời người nhà, trước khi mất tích, cả ba người đều thường bán cá cho cùng một bè ngoài khơi. Sự việc đang được xác minh thêm.", "Hải đăng Đá Canh Đêm bỏ trống từ năm ngoái, khi người gác đèn mất tích. Người nhà vừa tìm thấy một trang nhật ký ông để lại: \"...đèn xanh ở bè, không phải sương...\"", "Tin vắn: Bè tôm hùm ngoài khơi vừa mở rộng thêm lồng, chủ bè mới sắm ghe máy. Giá tôm hùm đầu mùa đang lên.", "Rằm tháng Bảy, Xóm Đèn thả đèn hoa đăng trên bến lúc chập tối, tưởng nhớ những người đã mất ngoài biển. Bà con nhớ giữ trẻ nhỏ xa mép nước."])
calm_missed_hint = "Người già dặn: Tháng Bảy biển êm mà hổng đi, hay đi mà về tay không, thì khuya thế nào cũng có người tới gõ cửa."
caught_missed_hint = "Người già dặn: Tháng Bảy thấy cái bóng lạ thì đứng xa xa. Lại gần là nó theo mình về."
