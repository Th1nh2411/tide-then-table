[gd_resource type="Resource" script_class="RamLinesData" format=3]

[ext_resource type="Script" path="res://data/resources/ram_lines_data.gd" id="1_ram"]

[resource]
script = ExtResource("1_ram")
ut_offer = Array[String](["Anh Út: Ê Rin! Rằm rồi, ngồi đây chút coi.", "Anh Út: Anh nấu bình trà gừng nè. Một ly cho ấm bụng rồi ra khơi.", "Anh Út: Đêm rằm biển êm lắm. Uống đi em."])
ut_drank = Array[String](["Anh Út: Đó. Ấm chưa?", "Anh Út: Tối nay ra khơi nghe. Anh chờ ngoài bè."])
ut_refused = Array[String](["Anh Út: ...Không uống hả?", "Anh Út: Ừ. Tùy em.", "Anh Út: Ra khơi nhớ cẩn thận. Đêm rằm dễ lạc lắm."])
bao = "Bảo: Anh Út đó. Ổng trả tiền lúc nào cũng ướt nhẹp, mùi dầu máy."
co_nam = "Cô Năm: Rằm rồi con. Tối nay cả xóm ra bến thả hoa đăng, cho người dưới biển có đèn mà về."
shore = Array[String](["Bà Sáu: Thả đi, cho người dưới biển thấy đường về.", "Ông Tám: Thúng trôi về không người... mà chưa ai có mồ.", "Bà Sáu: Qua rằm là cửa đóng. Năm sau mới lên được."])
gate_closed = Array[String](["...qua rằm rồi...", "...thêm một năm nữa..."])
whispers_drank = Array[String](["...dậy đi...", "...đừng ngủ, Rin...", "...nó tới rồi..."])
ut_at_sea = Array[String](["Anh Út: Ngủ đi em. Đêm rằm biển êm lắm.", "Anh Út: Ông nội em hồi đó cũng ngủ ngon vậy."])
whispers_trail = Array[String](["...theo đèn...", "...ra bè...", "...nhìn cho rõ..."])
ut_seen = Array[String](["Anh Út: ...Rin?", "Anh Út: Em ra đây chi giờ này?"])
dawn = Array[String](["Rạng sáng.", "Bảo: Thằng Rin thấy tận mắt. Cả xóm chèo ra bè lúc gà gáy.", "Cô Năm: Dưới bè... bảy cái xác quấn lưới, buộc đá.", "Ông Tám: Có ông Tư. Có cậu gác đèn Đá Canh Đêm. Có thằng Hai.", "Bảo: Thằng Út bị trói ngoài bến rồi. Nó không chối nữa.", "Cô Năm: Thả hoa đăng đi. Lần này họ về được rồi."])
grandpa = "Ông Tư: Về nhà đi con. Ông đi được rồi."
drowned = Array[String](["Tháng Bảy, năm sau.", "Anh Út: Mới về xóm hả em? Tối ra khơi hả?", "Anh Út: Ghé quán, anh rót ly trà gừng. Cho ấm bụng."])
card_true = Array[String](["Rằm tháng Bảy. Xóm Đèn thả hoa đăng.", "Bảy người được đưa vào bờ. Có mồ, có giỗ.", "Qua rằm. Năm nay không còn ai phải ở lại dưới nước."])
card_drowned = Array[String](["Thúng của ông Tư trôi về bến, không người.", "Bản tin sáng: thêm một ngư dân mất tích trong sương.", "Dưới bè tôm hùm, giờ có tám người."])
