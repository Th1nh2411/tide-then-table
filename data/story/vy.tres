[gd_resource type="Resource" script_class="LinesData" format=3]

[ext_resource type="Script" path="res://data/resources/lines_data.gd" id="1_lines"]

[resource]
script = ExtResource("1_lines")
speaker = "Vy"
lines = Array[String](["Ông Bảo rủ tui ra phụ, nói có bao cơm. Bao toàn mì gói không hà anh Rin.", "Tui bưng chậm lắm nha. Anh Rin lẹ chân thì gánh giùm.", "Hồi ở trọ ông Bảo nấu mì ngon nhứt dãy. Giờ nấu ốc mà tui vẫn nghe mùi mì.", "Bàn nào dơ tui dọn cho, anh lo bưng đi.", "Quen ổng từ hồi ổng còn để tóc dài. Đừng kể ổng nghe tui nói nha.", "Ông Bảo hay càm ràm mà chưa bỏ bữa nấu nào.", "Ổng nói anh Rin là đứa ổng tin nhứt. Câu đó ổng đâu có nói với tui.", "Anh Rin ăn gì chưa? Ông Bảo để phần trong nồi đó.", "Khách đông thì kệ, mình làm từ từ. Ông Bảo nói vậy chớ ổng hối dữ lắm.", "Gió ngoài bến lạnh lắm. Anh ra đó nhớ mặc áo ấm.", "Ông Bảo hỏi tui sao không về thành phố. Tui nói ở đây có người cần mì.", "Hết ca tui về liền nha, đường xóm tối lắm.", "Mai tui ra phụ nữa. Ông Bảo mà nấu dở thì tui chê thẳng.", "Ông Bảo nói tháng này ai kêu tên cũng đừng dạ. Tui dạ ổng hoài."])
