[gd_resource type="Resource" script_class="StaffData" format=3]

[ext_resource type="Script" path="res://data/resources/staff_data.gd" id="1_staff"]
[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="2_dlg"]
[ext_resource type="Resource" path="res://data/dialogues/vy_app.tres" id="3_app"]
[ext_resource type="Resource" path="res://data/dialogues/vy_fog.tres" id="4_fog"]
[ext_resource type="Resource" path="res://data/dialogues/vy_cat.tres" id="5_cat"]
[ext_resource type="Resource" path="res://data/dialogues/vy_omen.tres" id="6_omen"]
[ext_resource type="Resource" path="res://data/dialogues/vy_mark.tres" id="7_mark"]
[ext_resource type="Resource" path="res://data/dialogues/vy_stay.tres" id="8_stay"]

[resource]
script = ExtResource("1_staff")
id = "vy"
display_name = "Vy"
tier = 2
wage = 200
walk_speed = 100.0
clean_seconds = 0.5
tip_bonus = 0.15
body_color = Color(0.9, 0.45, 0.55, 1)
pitch = "Em là Vy, nhà ở xóm trên. Em cần tiền đi chơi, làm đủ là nghỉ nha. Chỉ bưng với dọn, không đụng cá sống."
arrives_on_day = 4
dialogues = Array[ExtResource("2_dlg")]([ExtResource("3_app"), ExtResource("4_fog"), ExtResource("5_cat"), ExtResource("6_omen"), ExtResource("7_mark"), ExtResource("8_stay")])
idle_lines = Array[String](["Bàn này ai ăn mà như bãi chiến trường vậy?", "Mùi cá dính tóc em rồi nè!", "Đeo găng rồi mà đụng vỏ ốc vẫn ghê.", "Còn mấy ca nữa là em đủ tiền rồi.", "Tụi bạn em đăng ảnh đi biển kìa. Biển sạch nha."])
later_flag = "vy_warmed"
later_idle_lines = Array[String](["Bàn 3 xong rồi anh Rin!", "Hôm nay khách đông, vui ghê.", "Anh Bảo, cho em nêm thử nha?", "Em quen mùi cá rồi. Nói ra ai tin.", "Anh Rin, nghĩ ra mình thích gì chưa?"])
