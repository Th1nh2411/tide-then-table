[resource]
script = ExtResource("1_omen")
id = "tien_le"
where = 1
title = "Tiền lẻ rơi trên đường ra bến"
text = ""
calm_text = ""
co_nam_line = "Hồi nãy cô thấy tiền lẻ rớt dọc đường ra bến. Tháng này đừng có lượm nghe con."
