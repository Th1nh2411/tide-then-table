[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_omen"
min_day = 1
priority = 12
requires_flag = "fog_omen_day"
script_text = "Vy: Cả xóm đồn ầm, có ánh sáng xanh ngoài sương. Anh chủ quán định ra đó hả?
Rin: Ừ. Mai sương mở, chắc anh ra coi. Tới đâu hay tới đó.
Vy (kieu): Tới đâu hay tới đó... Đi thì trả lương em trước đã nha."
