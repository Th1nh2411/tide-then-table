[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "cat_mark"
min_day = 1
priority = 14
requires_flag = "wave_mark"
script_text = "{pet}: ...
Rin: Mày nhìn tay tao hoài vậy?
{pet}: Meo. (mắt sáng xanh lên một thoáng, đúng nhịp với vệt trên tay Rin)
Rin: ...Tao bắt đầu thấy mày không phải mèo thường rồi đó."
