[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_cat"
min_day = 5
priority = 8
requires_flag = "cat_adopted"
script_text = "Vy: {pet} lúc nào cũng nằm ngó ra biển, như đang đợi ai.
Rin: Nó đợi cá thôi.
Vy (lo): Không đâu... Em thấy mắt nó sáng xanh, giống cái ánh sáng ông em kể."
