[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_fog"
min_day = 4
priority = 9
requires_flag = "vy_warmed"
script_text = "Vy: Anh Rin, hôm qua em về hỏi ông nội chuyện dải sương phía đông bắc.
Vy: Ông nói đêm trăng tối, trong sương sáng xanh xanh, như có ai thắp đèn dưới nước.
Rin: Ông em ra đó lần nào chưa?
Vy (lo): Ông nói ghe nào đi vô thì về, mà không ai nhớ đã thấy gì. Ông dặn em kể anh nghe.
Vy (boi_roi): Không phải em lo cho anh đâu nha. Em tò mò thôi."
