[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_fog"
min_day = 4
priority = 9
requires_flag = "vy_warmed"
script_text = "Vy: Anh Rin, hôm qua em hỏi ông nội chuyện dải sương. Ông nói hồi đó ông Tư rủ ông đi vô, ông không dám.
Rin: Ông Tư... ông nội anh?
Vy (lo): Dạ. Ông nói ghe chạy ngoài mép sương thì về được, mà về là quên sạch đã thấy gì.
Vy (lo): Còn ai lặn theo cá Ông xuống dưới thì không về. Ông Tư đi một mình, không ai cản kịp.
Vy (boi_roi): Ông dặn em kể anh nghe. Không phải em lo cho anh đâu nha."
