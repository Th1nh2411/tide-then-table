[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_stay"
min_day = 5
priority = 11
requires_flag = "vy_warmed"
script_text = "Vy: Anh Rin, em đủ tiền đi chơi rồi.
Rin: Vậy hả. Em nghỉ thì... chắc cũng ổn. Sao cũng được.
Vy (kieu): Ai nói em nghỉ? Em hủy chuyến rồi. Đi với tụi nó chán lắm, ở đây còn có mì anh Bảo.
Vy: Còn anh đó. Ngoài câu cá với bưng bê, anh thích cái gì?
Rin: ...Anh chưa biết. Chắc ra biển thêm vài đêm thì biết.
Vy (vui): Vậy em ở lại coi anh biết ra cái gì."
