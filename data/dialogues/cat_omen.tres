[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "cat_omen"
requires_flag = "fog_omen_day"
priority = 7
script_text = "{pet} không nằm yên. Nó cứ đứng trên quầy, nhìn chằm chằm về phía biển, hướng đông bắc.
Rin: Mày thấy gì ngoài đó vậy?
Đuôi {pet} dựng đứng. Mắt nó loé lên một ánh xanh rồi tắt."
