[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "bao_vy"
min_day = 3
once = true
priority = 15
script_text = "Bảo: Ê, có con bé tên Vy ở xóm trên hỏi xin làm thêm buổi tối nè.
Rin: Quán mình nuôi thêm người nổi không?
Bảo: Mày chạy muốn rớt dép mỗi tối còn hỏi. Bấm \"Nhân viên\" mà coi.
Bảo: Mà thiếu người thì dán tờ rơi, đăng tin tuyển. Tốn chút tiền mà có người xịn."
