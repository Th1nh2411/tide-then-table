[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_app"
min_day = 4
priority = 10
script_text = "Vy (kieu): Anh Rin, cái app trên điện thoại anh nhìn quê dữ vậy. Anh tự viết hả?
Rin: Ừ. Hồi làm startup với Bảo. Giờ xài quản lý quán.
Vy: Log toàn chữ đỏ [ERR] kìa. Có dòng \"tọa độ không tồn tại\" nữa.
Rin (boi_roi): ...Chắc GPS lỗi. Kệ, chạy được là được.
Vy (che): Hèn chi startup anh sập."
