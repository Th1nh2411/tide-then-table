[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_app"
min_day = 4
priority = 10
blocked_by_flag = "vy_warmed"
script_text = "Vy (kieu): Cái giọng trong app anh tự xưng NEO hả? Nó gọi anh là \"anh Rin\", lễ phép hơn anh nữa.
Rin: NEO là cái AI hồi startup. Tụi anh lấy lõi của nó trong một bộ SDK có sẵn.
Vy: SDK của ai?
Rin (boi_roi): ...Không nhớ. Kệ, chạy được là được.
Vy (che): Hèn chi startup anh sập."
