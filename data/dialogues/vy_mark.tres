[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://data/resources/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
id = "vy_mark"
min_day = 1
priority = 14
requires_flag = "wave_mark"
script_text = "Vy (che): Ê, tay anh bị gì vậy? Xanh xanh như hình con sóng... đừng đụng vô dĩa của khách nha.
Rin: Hôm trước ra khơi... nói ra em không tin đâu.
Vy: Ông nội em kể, ai được cá Ông \"đánh dấu\" thì biển nhường cho người đó một nhịp.
Vy (kieu): Ông nói vậy thôi, em không tin. Mà quán đông quá thì... xài đỡ cũng được."
